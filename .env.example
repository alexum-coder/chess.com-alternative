# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SECRET: server only. Never expose this in client code or commit it to GitHub.
SUPABASE_SERVICE_KEY=your-service-role-key
# Comma-separated Supabase auth user UUIDs with moderator access (optional).
ADMIN_USER_IDS=

# Stockfish native executable (download from https://stockfishchess.org/download/).
# Leave as 'stockfish' when the executable is on PATH.
STOCKFISH_PATH=stockfish
STOCKFISH_DEPTH=11
STOCKFISH_MIN_PLY=10
STOCKFISH_MAX_PLIES=60
STOCKFISH_MIN_SAMPLES=12
STOCKFISH_CONCORDANCE=0.90
STOCKFISH_AVG_CPL=18

# Public Supabase Storage bucket for browser Stockfish JS/WASM assets.
# Run `npm run upload:stockfish` locally after npm install to upload the files.
STOCKFISH_STORAGE_BUCKET=stockfish

# Optional server-side anti-cheat engine stored in a PRIVATE bucket.
# Upload a Linux ELF binary (not a Windows .exe) with the script below.
# npm run upload:stockfish-native -- ./path/to/linux/stockfish
# Set these in Render only after uploading the Linux binary. Leave blank locally.
# STOCKFISH_NATIVE_BUCKET=stockfish-native
# STOCKFISH_NATIVE_OBJECTS=stockfish-linux-x64.gz.part-001,stockfish-linux-x64.gz.part-002
# The upload script defaults to 45 MiB chunks, leaving margin below Supabase Free's 50 MB per-file cap.
# STOCKFISH_NATIVE_PART_SIZE_MB=45
# STOCKFISH_NATIVE_MAX_UPLOAD_MB=50
