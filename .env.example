# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SECRET: server only. Never expose this in client code or commit it to GitHub.
SUPABASE_SERVICE_KEY=your-service-role-key
# Comma-separated Supabase auth user UUIDs with moderator access (optional).
ADMIN_USER_IDS=
