# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SECRET: server only. Never expose this in client code or commit it to GitHub.
SUPABASE_SERVICE_KEY=your-service-role-key
# Comma-separated Supabase auth user UUIDs with moderator access (optional).
ADMIN_USER_IDS=

# Stockfish native executable (download from https://stockfishchess.org/download/).
# Leave as 'stockfish' when the executable is on PATH.
STOCKFISH_PATH=stockfish
STOCKFISH_DEPTH=11
STOCKFISH_MIN_PLY=10
STOCKFISH_MAX_PLIES=60
STOCKFISH_MIN_SAMPLES=12
STOCKFISH_CONCORDANCE=0.90
STOCKFISH_AVG_CPL=18
